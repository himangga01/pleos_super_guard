<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- PC의 모의 서버(http://10.0.2.2:8766 또는 adb reverse 뒤 127.0.0.1)와 주고받습니다. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- 위험 권한은 쓰는 순간에 묻습니다: 소리 기록 = 마이크, 경고등 · 사진 · QR = 카메라, 알림 요청 = 알림(Android 13+). -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Android 12+는 이 권한이 없으면 가속도계를 200Hz로 묶습니다(일반 권한, 묻지 않음). -->
  <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

  <uses-feature android:name="android.hardware.camera.any" android:required="false" />
  <uses-feature android:name="android.hardware.microphone" android:required="false" />
  <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

  <application
      android:label="@string/app_name"
      android:icon="@drawable/app_icon"
      android:roundIcon="@drawable/app_icon"
      android:theme="@style/Theme.PleosCarePhone"
      android:allowBackup="false"
      android:supportsRtl="false"
      android:usesCleartextTraffic="true"
      android:name=".PhoneApp">
    <activity
        android:name=".MainActivity"
        android:theme="@style/Theme.PleosCarePhone.Launch"
        android:exported="true"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!-- 차 화면 QR(pleoscare://pair?code=123456&server=...)을 폰 기본 카메라로 찍어도 이 앱이 열립니다. -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="pleoscare" android:host="pair" />
      </intent-filter>
    </activity>
  </application>
</manifest>

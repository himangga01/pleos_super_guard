<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Pleos 차량 전용. FusedLocation AAR도 같은 선언을 요구합니다. -->
  <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

  <!-- Vehicle SDK 2.3.2 실행 검사 권한(normal). 설계 문서 docs/sdk/vehicle-api-catalog.md 기준 -->
  <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
  <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
  <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
  <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
  <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
  <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
  <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
  <uses-permission android:name="pleos.car.permission.CAR_INFO" />
  <!-- 음성·위치·내비 SDK -->
  <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
  <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
  <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
  <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
  <!-- AAOS 차속(PERF_VEHICLE_SPEED). dangerous 권한이라 실행 중에 허락을 받습니다. -->
  <uses-permission android:name="android.car.permission.CAR_SPEED" />

  <application
      android:label="@string/app_name"
      android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
    <!--
      창 크기가 바뀌어도(세로 한 창 ↔ 가로) 진행 중인 안내 단계와 발송 확인 남은 시간을 유지하려고 다시 만들지 않습니다(UX 4.6).
      주행 중 사용(Distraction Optimization) 선언: AAOS 표준 meta-data. Pleos 가이드(G4·G5)는 DO 선언 앱만 주행 중에 쓸 수 있고,
      선언한 앱도 CarUxRestrictions에 따라 기능을 줄여야 한다고 안내합니다. 에뮬레이터에서 실제로 받아들여지는지는 로컬 확인 기록을 봅니다.
    -->
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboard|keyboardHidden|navigation">
      <meta-data android:name="distractionOptimized" android:value="true" />
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
